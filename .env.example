# Vercel KV / Upstash Redis credentials.
# In Vercel these are set automatically when you connect a KV/Upstash store.
# For local development or running the migration script, copy this file to
# .env.local and fill in the values from the Vercel/Upstash dashboard.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# The Upstash Marketplace integration sometimes uses these names instead;
# either pair works (the app checks both).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Preferred production store: Neon Postgres via the Vercel Marketplace.
# When DATABASE_URL is set, the app uses Postgres instead of Redis.
# DATABASE_URL=

# Optional emergency override: preserve DATABASE_URL of the old source.
# REMARKT_DATABASE_URL=
# An explicit workspace ID isolates browser backups and rejects stale tabs.
# REMARKT_WORKSPACE_ID=

# Enable only after the protected migration and content verification.
# REMARKT_STORAGE_FORMAT=3
# REMARKT_SESSION_SECRET=private-random-secret-at-least-32-characters
# Maintenance only: never expose these in the browser or commit actual values.
# REMARKT_DATABASE_URL_UNPOOLED=
# REMARKT_BACKUP_DIR=C:\ReMarkt-Backups\grading
# REMARKT_BACKUP_KEY=64-hex-characters-generated-by-configure-record-backup
